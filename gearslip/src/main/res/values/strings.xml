    <string name="guide_audio_bluetooth">Bluetooth</string>
    <string name="guide_recommended">Recommended</string>
    <string name="guide_audio_bluetooth_body">No prompt each drive, and your map app\'s voice reaches the car.</string>
    <string name="guide_audio_usb">Through Gearslip</string>
    <string name="guide_audio_usb_body">Clearer sound with no delay, but your map app\'s spoken directions play on the phone, not in the car. Each drive, Android asks you to share your screen, which lets Gearslip send the sound.</string>
    <string name="home_audio_usb_warning">Spoken directions from map apps play on the phone, not in the car. Choose Bluetooth to hear them in the car.</string>
